# ==========================================
# SEA//SAFE Environment Configuration Template
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# NASA Earthdata Authentication (PO.DAAC / CMR)
# Register for free at: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_TOKEN=your_earthdata_bearer_token

# Storage and Caching
DATA_DIR=/app/data
CACHE_TYPE=memory
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://redis:6379/0

# Geospatial Default Target (Thiruvananthapuram Coast, Kerala)
DEFAULT_REGION_NAME=Thiruvananthapuram
DEFAULT_LAT_MIN=8.0
DEFAULT_LAT_MAX=9.0
DEFAULT_LON_MIN=76.5
DEFAULT_LON_MAX=77.5
DEFAULT_BUFFER_KM=10

# Scientific Climatology Baseline Period
BASELINE_START_YEAR=2003
BASELINE_END_YEAR=2020
